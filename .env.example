# LinkedIn credentials (required for scraping)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# AI provider: anthropic, openai, or custom
LLM_PROVIDER=anthropic
# Model name (provider-dependent):
#   Anthropic: claude-sonnet-4-6, claude-haiku-4-5, etc.
#   OpenAI:   gpt-4o, gpt-4o-mini, etc.
#   Custom:   any model your endpoint supports
LLM_MODEL=claude-sonnet-4-6

# API key for your chosen provider
LLM_API_KEY=sk-ant-api03-...

# Custom provider only — set the base URL for your OpenAI-compatible endpoint
# e.g. https://api.openrouter.ai/v1 or http://localhost:11434/v1
# LLM_BASE_URL=
